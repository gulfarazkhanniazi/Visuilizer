{
  "name": "surface-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "Wall & floor tile visualizer - photoreal room preview with perspective-correct tiling, masking and baked-light compositing.",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "seed": "npm run seed -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
